# API 凭证配置示例
# 请在本地 .env 或环境变量中设置这些值

# SerpAPI - Google Lens 反向图搜和文本搜索
# 获取地址: https://serpapi.com/
SERPER_API_KEY=your_serper_api_key_here

# 高德地图 API - 反向地理编码
# 获取地址: https://lbs.amap.com/
AMAP_API_KEY=your_amap_api_key_here

# Oxylabs 代理服务 - 爬虫代理
# 获取地址: https://oxylabs.io/
OXYLABS_USER=your_oxylabs_username_here
OXYLABS_PASSWORD=your_oxylabs_password_here
